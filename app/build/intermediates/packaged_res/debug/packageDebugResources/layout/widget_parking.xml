<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 상단 헤더: 타이틀, 저장시각 & 음성 안내 스피커 토글 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_title"
            android:textColor="#1E88E5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetUpdateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="방금 전"
            android:textColor="#757575"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/btnWidgetTtsToggle"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/cd_tts_toggle"
            android:padding="2dp"
            android:src="@drawable/ic_volume_up" />
    </LinearLayout>

    <!-- 중앙: 현재 주차 위치 결과 디스플레이 -->
    <TextView
        android:id="@+id/tvWidgetLocation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="6dp"
        android:layout_weight="1"
        android:background="#E3F2FD"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:text="저장된 주차 위치 없음"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- 하단: 위치 저장 / 카메라 스캔 / 음성 입력 / 내 차 찾기 액션 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnWidgetSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_primary"
            android:paddingHorizontal="1dp"
            android:text="위치 저장"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_camera"
            android:paddingHorizontal="1dp"
            android:text="📷 스캔"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetVoice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="1dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_voice"
            android:paddingHorizontal="1dp"
            android:text="@string/widget_btn_voice"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWidgetFind"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_btn_accent"
            android:paddingHorizontal="1dp"
            android:text="내 차 찾기"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
