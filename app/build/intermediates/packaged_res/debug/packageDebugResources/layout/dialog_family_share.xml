<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 1. 내 닉네임 설정 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내 닉네임 (가족에게 표시될 이름)"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUserNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: 아빠, 엄마, 나"
            android:inputType="textPersonName"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="18dp"
        android:background="@color/divider" />

    <!-- 2. 현재 공유 그룹 상태 카드 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="현재 가족 공유 그룹"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#ECEFF1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCurrentGroupId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="FAM789 (연결됨)" />

        <!-- 복사 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyGroupId"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="코드 복사"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <!-- 초대장 공유 버튼 -->
        <ImageButton
            android:id="@+id/btnShareInvite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="초대장 전송"
            android:src="@drawable/ic_group"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- 그룹 나가기 텍스트 버튼 -->
    <TextView
        android:id="@+id/btnLeaveGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="4dp"
        android:text="그룹 나가기 (연결 해제)"
        android:textColor="#E53935"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="18dp"
        android:background="@color/divider" />

    <!-- 3. 새로운 그룹 참여하기 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="초대 코드로 참여하기"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInputGroupId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="6자리 초대 코드"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinGroup"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="참여"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- 4. 새 그룹 생성 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateNewGroup"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="새 가족 그룹 생성하기"
        android:textColor="@color/primary"
        app:cornerRadius="8dp"
        app:strokeColor="@color/primary" />

</LinearLayout>
