<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- 상단 툴바 / 앱바 -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/white">

            <!-- 음성 읽어주기 (TTS) ON/OFF 스위치 버튼 -->
            <ImageButton
                android:id="@+id/btnTtsToggle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_tts_toggle"
                android:src="@drawable/ic_volume_up"
                app:tint="@color/white" />

            <!-- 가족 공유 버튼 -->
            <ImageButton
                android:id="@+id/btnFamilyGroup"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="가족 공유 설정"
                android:src="@drawable/ic_group"
                app:tint="@color/white" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 스크롤 가능한 본문 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 1. 현재 저장된 주차 위치 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCurrentLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="자동차 아이콘"
                            android:src="@drawable/ic_car"
                            app:tint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="현재 내 차 위치"
                            android:textColor="@color/primary"
                            android:textSize="18sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvCurrentUpdateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="10분 전 저장됨" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCurrentParkingDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#E3F2FD"
                        android:gravity="center"
                        android:paddingVertical="14dp"
                        android:text="저장된 주차 위치가 없습니다"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="지하 2층 (B2) • A15 기둥" />

                    <!-- '내 차 찾기' 버튼 (팝업 + TTS 음성 안내) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFindMyCar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/accent"
                        android:text="@string/btn_find_my_car"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_car"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. 주차 위치 신규 등록 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="@string/title_parking_input"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp" />

                    <!-- 층수 선택 라벨 및 드롭다운(Spinner) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_select_floor"
                        android:textColor="@color/dark_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerFloor"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_spinner"
                        android:spinnerMode="dropdown" />

                    <!-- 기둥 번호 입력 필드 및 음성 마이크 버튼 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="기둥 번호"
                        android:textColor="@color/dark_red"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPillar"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxStrokeColor="@color/dark_red"
                            app:hintTextColor="@color/dark_red">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPillar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/hint_pillar_number"
                                android:imeOptions="actionDone"
                                android:inputType="textCapCharacters"
                                android:maxLines="1"
                                android:textColor="@color/dark_red"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- 음성 입력 (STT) 마이크 버튼 -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnVoiceInput"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:contentDescription="@string/btn_voice_input"
                            app:backgroundTint="@color/primary"
                            app:elevation="2dp"
                            app:fabSize="normal"
                            app:srcCompat="@drawable/ic_mic"
                            app:tint="@color/white" />

                    </LinearLayout>

                    <!-- 음성 안내 힌트 문구 -->
                    <TextView
                        android:id="@+id/tvVoiceHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="💡 마이크를 누르고 '지하 2층 A기둥'처럼 말해보세요"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- 위치 저장하기 버튼 -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveLocation"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/primary"
                        android:text="@string/btn_save_location"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_save"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. 주차 히스토리 목록 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/title_history"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <!-- 기록이 비어있을 때 표시 -->
                <TextView
                    android:id="@+id/tvEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:text="주차 히스토리가 없습니다."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- 히스토리 리스트 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvParkingHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_parking_history" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
