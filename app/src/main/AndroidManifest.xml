<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 인터넷 권한 (Firebase 실시간 연동) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 음성 인식(STT) 마이크 권한 및 카메라 권한 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Android 11(API 30) 이상 SpeechRecognizer 패키지 가시성 선언 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkingReminder">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 위젯 음성 입력 전용 반투명 플로팅 액티비티 -->
        <activity
            android:name=".ui.VoiceInputActivity"
            android:exported="false"
            android:theme="@style/Theme.ParkingReminder.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 위젯/앱 카메라 OCR 자동 인식 전용 반투명 플로팅 액티비티 -->
        <activity
            android:name=".ui.CameraScanActivity"
            android:exported="false"
            android:theme="@style/Theme.ParkingReminder.Translucent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- 스마트폰 홈 화면 주차 위젯 (4x2 기본) -->
        <receiver
            android:name=".widget.ParkingWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.parking.reminder.ACTION_FIND_CAR" />
                <action android:name="com.parking.reminder.ACTION_UPDATE_DATA" />
                <action android:name="com.parking.reminder.ACTION_TOGGLE_TTS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info" />
        </receiver>

        <!-- 스마트폰 홈 화면 주차 위젯 (2x1 가로 컴팩트) -->
        <receiver
            android:name=".widget.ParkingWidgetProvider2x1"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.parking.reminder.ACTION_FIND_CAR" />
                <action android:name="com.parking.reminder.ACTION_UPDATE_DATA" />
                <action android:name="com.parking.reminder.ACTION_TOGGLE_TTS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_2x1" />
        </receiver>

        <!-- 스마트폰 홈 화면 주차 위젯 (1x2 세로 슬림) -->
        <receiver
            android:name=".widget.ParkingWidgetProvider1x2"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.parking.reminder.ACTION_FIND_CAR" />
                <action android:name="com.parking.reminder.ACTION_UPDATE_DATA" />
                <action android:name="com.parking.reminder.ACTION_TOGGLE_TTS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parking_widget_info_1x2" />
        </receiver>

    </application>

</manifest>
